# Create a unique JWT HMAC key for this deployment; leave this empty in version control.
SUNO_JWT_SECRET=
# Supply the payment-provider callback verification secret from the provider or secret manager.
PAYMENT_CALLBACK_SECRET=
# Set these only for the mysql profile; use a least-privilege application account.
SUNO_DB_USERNAME=
SUNO_DB_PASSWORD=
# Optional Redis cache connection; Redis is not a readiness dependency in Phase 0.
SUNO_REDIS_HOST=localhost
SUNO_REDIS_PORT=6379
SUNO_REDIS_PASSWORD=
SUNO_REDIS_DATABASE=0
# Optional credentials when a real provider mode is enabled.
BAIDU_IMAGE_AUDIT_ACCESS_TOKEN=
LOGISTICS_API_KEY=
